+);
+
+/// Rejects encrypted delivery to a provider that cannot decrypt it, before the
+/// target agent is created or messaged, so misconfiguration fails loudly
+/// instead of producing an unusable agent.
+pub(crate) fn ensure_delivery_supported_by_provider(
+    encrypted: bool,
+    provider_is_openai: bool,
+) -> Result<(), FunctionCallError> {
+    if encrypted && !provider_is_openai {
+        return Err(FunctionCallError::RespondToModel(
+            ENCRYPTED_DELIVERY_TO_NON_OPENAI_MESSAGE.to_string(),
+        ));
+    }
+    Ok(())
+}
