+/// Deployment escape hatch for plaintext delivery that avoids editing the shared
+/// `config.toml`: stock codex builds reject unknown keys under
+/// `[features.multi_agent_v2]` and router tooling may rewrite the managed block,
+/// so an environment override lets a patched binary opt in without touching the
+/// file other codex builds parse. Unrecognized values fall back to the config.
+fn multi_agent_v2_message_delivery_from_env(
+    configured: MultiAgentV2MessageDelivery,
+) -> MultiAgentV2MessageDelivery {
+    match std::env::var("CODEX_MULTI_AGENT_V2_MESSAGE_DELIVERY")
+        .as_deref()
+        .map(str::trim)
+    {
+        Ok("plaintext") => MultiAgentV2MessageDelivery::Plaintext,
+        Ok("encrypted") => MultiAgentV2MessageDelivery::Encrypted,
+        _ => configured,
+    }
