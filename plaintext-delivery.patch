+            arguments: "{}".to_string(),
+        },
+        encrypted_function_args: None,
+    };
+    assert_eq!(
+        plain.direct_source(Some("agents")),
+        ToolCallSource::DirectPlaintextMessage
+    );
+    assert_eq!(plain.direct_source(None), ToolCallSource::Direct);
+}
+
+#[test]
+fn direct_source_never_wraps_real_encrypted_args_as_plaintext() {
+    // Real encrypted arguments stay Direct even under the plaintext policy, so
+    // ciphertext is never re-labeled as a plaintext message.
+    assert_eq!(
+        collab_call("agents", Some(vec!["ciphertext".to_string()]))
+            .direct_source(Some("agents")),
+        ToolCallSource::Direct
+    );
+    assert_eq!(
+        collab_call("collaboration", Some(vec!["ciphertext".to_string()]))
+            .direct_source(Some("collaboration")),
+        ToolCallSource::Direct
+    );
+}
