+
+#[test]
+fn direct_source_keeps_encrypted_classification_for_marker_and_default() {
+    // Reserved namespace with the empty encrypted-args marker stays plaintext (server marker path).
+    assert_eq!(
+        collab_call("collaboration", Some(Vec::new())).direct_source(None),
+        ToolCallSource::DirectPlaintextMessage
+    );
+    // Without the marker and without a plaintext policy, encrypted args classify as Direct.
+    assert_eq!(
+        collab_call("collaboration", None).direct_source(None),
+        ToolCallSource::Direct
+    );
+}
+
+#[test]
+fn direct_source_classifies_configured_namespace_as_plaintext() {
+    // Plaintext policy with a custom namespace classifies calls without any marker.
+    assert_eq!(
+        collab_call("agents", None).direct_source(Some("agents")),
+        ToolCallSource::DirectPlaintextMessage
+    );
+    // Plaintext policy keeps working with the default reserved namespace.
+    assert_eq!(
+        collab_call("collaboration", None).direct_source(Some("collaboration")),
+        ToolCallSource::DirectPlaintextMessage
+    );
+    // A namespace other than the configured one stays Direct.
+    assert_eq!(
+        collab_call("other", None).direct_source(Some("agents")),
+        ToolCallSource::Direct
+    );
+    // Un-namespaced collaboration tools (providers without namespace support)
+    // classify as plaintext when plaintext delivery is configured.
+    let plain = ToolCall {
+        tool_name: ToolName::plain("spawn_agent"),
+        call_id: "call-plain".to_string(),
